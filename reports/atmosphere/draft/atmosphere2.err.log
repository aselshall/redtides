    fig, ax = plt.subplots(figsize=(14, 6))
    ax.plot(data.index, data['WSPD'], color='blue', label='Wind Speed (m/s)', alpha=0.7)
    ax.set_title('Wind Speed Over Time')
    ax.set_xlabel('Date')
    ax.set_ylabel('Wind Speed (m/s)')

