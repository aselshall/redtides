            if Plot_KB_Flag==1:
                plot_KB(data_plot_flag,df,Q,min_bloom_length,max_gaps_days,n_large_blooms,n_large_bloom_periods,bloom_periods_ratio)

    #Part2: zos analysis 

            #[11] zos dataFrames
            #(1) Results summary

            if Start_KB_df_flag==1:
                res=pd.DataFrame({'Setting':['Maze'],'period': ['Q'],'segment': ['0_0'], \
